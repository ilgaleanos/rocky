{
  "backend_url": "http://localhost:8080",
  "global_whitelist": [],
  "trusted_proxies": [],
  "trusted_hops": 0,
  "routes": [
    {
      "path": "/admin/auth/**",
      "rules": [
        {
          "identifiers": [
            "ip"
          ],
          "limit": 4,
          "window_secs": 30,
          "on_limit_exceeded": {
            "duration_secs": 60
          }
        }
      ]
    },
    {
      "path": "/api/security/**",
      "rules": [
        {
          "identifiers": [
            "ip"
          ],
          "limit": 12,
          "window_secs": 60,
          "on_limit_exceeded": {
            "duration_secs": 60
          }
        }
      ]
    },
    {
      "path": "/api/web/**",
      "rules": [
        {
          "identifiers": [
            "header:authorization"
          ],
          "limit": 16,
          "window_secs": 30,
          "on_limit_exceeded": {
            "duration_secs": 15
          }
        },
        {
          "identifiers": [
            "header:authorization"
          ],
          "limit": 80,
          "window_secs": 3600,
          "on_limit_exceeded": {
            "duration_secs": 0
          }
        },
        {
          "identifiers": [
            "ip"
          ],
          "limit": 400,
          "window_secs": 3600,
          "on_limit_exceeded": {
            "duration_secs": 0
          }
        }
      ]
    },
    {
      "path": "/**",
      "rules": [
        {
          "identifiers": [
            "ip"
          ],
          "limit": 1000,
          "window_secs": 10,
          "on_limit_exceeded": {
            "duration_secs": 10
          }
        }
      ]
    }
  ]
}
